# ==============================================================================
# EMAILJS / SMTP CONFIGURATION
# ==============================================================================
# 1. Sign up for a free account at https://www.emailjs.com
# 2. Add an Email Service (connect your Gmail or custom SMTP server)
# 3. Create an Email Template for receiving inquiries (Owner Notification Template)
# 4. (Optional) Create an Auto-Reply Template for sending instant confirmation to the client
# 5. Copy the Service ID, Template IDs, and Public Key below into your .env file
# ==============================================================================

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_owner_template_id
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_autoreply_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
